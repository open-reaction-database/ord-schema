[
  {
    "question": "which reactions use pyridine as a solvent?",
    "why": "two conditions on one element, which a wrong translation splits in two",
    "reference": {
      "where": {
        "op": "exists",
        "path": "inputs.components",
        "where": {
          "op": "and",
          "clauses": [
            {
              "op": "eq",
              "path": "reaction_role",
              "value": {
                "literal": "SOLVENT"
              }
            },
            {
              "op": "same_compound",
              "path": "smiles",
              "smiles": "c1ccncc1"
            }
          ]
        }
      }
    }
  },
  {
    "question": "reactions run above 350 K",
    "why": "a scalar comparison needing no quantifier at all",
    "reference": {
      "where": {
        "op": "gt",
        "path": "conditions.temperature.setpoint_kelvin",
        "value": {
          "literal": 350
        }
      }
    }
  },
  {
    "question": "reactions where a desired product has a yield above 50%",
    "why": "correlation: the yield has to belong to the desired product, not to whichever product happens to carry one",
    "reference": {
      "where": {
        "op": "exists",
        "path": "outcomes.products",
        "where": {
          "op": "and",
          "clauses": [
            {
              "op": "eq",
              "path": "is_desired_product",
              "value": {
                "literal": true
              }
            },
            {
              "op": "exists",
              "path": "measurements",
              "where": {
                "op": "and",
                "clauses": [
                  {
                    "op": "eq",
                    "path": "type",
                    "value": {
                      "literal": "YIELD"
                    }
                  },
                  {
                    "op": "gt",
                    "path": "percentage.value",
                    "value": {
                      "literal": 50
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  {
    "question": "reactions with no solvent at all",
    "why": "a forall, which the occurrence index cannot answer",
    "reference": {
      "where": {
        "op": "forall",
        "path": "inputs.components",
        "where": {
          "op": "ne",
          "path": "reaction_role",
          "value": {
            "literal": "SOLVENT"
          }
        }
      }
    }
  },
  {
    "question": "reactions that ran longer than their workup took",
    "why": "comparing two columns, which the grammar cannot express: a value is a literal or a compound, never another column",
    "compiles": false
  },
  {
    "question": "reactions with a nitro group on any input",
    "why": "a substructure query, which a translation that filters SMILES text with contains gets wrong in both directions",
    "reference": {
      "where": {
        "op": "exists",
        "path": "inputs.components",
        "where": {
          "op": "substructure",
          "path": "smiles",
          "smarts": "[N+](=O)[O-]"
        }
      }
    }
  },
  {
    "question": "reactions using an input with Tanimoto similarity at least 0.6 to aniline",
    "why": "similarity is its own predicate over the fingerprints, not a substructure and not a text match",
    "reference": {
      "where": {
        "op": "exists",
        "path": "inputs.components",
        "where": {
          "op": "similarity",
          "path": "smiles",
          "smiles": "Nc1ccccc1",
          "threshold": 0.6
        }
      }
    }
  },
  {
    "question": "reactions using triethylamine, whichever salt it was sold as",
    "why": "same_parent, not same_compound: the hydrochloride has to match, which an eq on smiles and a same_compound both miss",
    "reference": {
      "where": {
        "op": "exists",
        "path": "inputs.components",
        "where": {
          "op": "same_parent",
          "path": "smiles",
          "smiles": "CCN(CC)CC"
        }
      }
    }
  },
  {
    "question": "reactions run in either DMSO or DMF",
    "why": "an or, which a translation that writes and returns nothing for: one component is not two solvents at once",
    "reference": {
      "where": {
        "op": "exists",
        "path": "inputs.components",
        "where": {
          "op": "and",
          "clauses": [
            {
              "op": "eq",
              "path": "reaction_role",
              "value": {
                "literal": "SOLVENT"
              }
            },
            {
              "op": "or",
              "clauses": [
                {
                  "op": "same_compound",
                  "path": "smiles",
                  "smiles": "CS(C)=O"
                },
                {
                  "op": "same_compound",
                  "path": "smiles",
                  "smiles": "CN(C)C=O"
                }
              ]
            }
          ]
        }
      }
    }
  },
  {
    "question": "reactions that used no palladium catalyst",
    "why": "negation outside the quantifier: no catalyst on the reaction is palladium. Its pair below is the counterexample, and a reaction running palladium alongside nickel is what separates them",
    "reference": {
      "where": {
        "op": "not",
        "clause": {
          "op": "exists",
          "path": "inputs.components",
          "where": {
            "op": "and",
            "clauses": [
              {
                "op": "eq",
                "path": "reaction_role",
                "value": {
                  "literal": "CATALYST"
                }
              },
              {
                "op": "substructure",
                "path": "smiles",
                "smarts": "[Pd]"
              }
            ]
          }
        }
      }
    }
  },
  {
    "question": "reactions that used a non-palladium catalyst",
    "why": "negation inside the quantifier: some catalyst is not palladium, which the reaction above excludes and this one keeps",
    "reference": {
      "where": {
        "op": "exists",
        "path": "inputs.components",
        "where": {
          "op": "and",
          "clauses": [
            {
              "op": "eq",
              "path": "reaction_role",
              "value": {
                "literal": "CATALYST"
              }
            },
            {
              "op": "not",
              "clause": {
                "op": "substructure",
                "path": "smiles",
                "smarts": "[Pd]"
              }
            }
          ]
        }
      }
    }
  },
  {
    "question": "reactions where nobody recorded a temperature",
    "why": "absence, not zero: an eq on 0 K finds nothing and a translation that writes one looks right",
    "reference": {
      "where": {
        "op": "is_null",
        "path": "conditions.temperature.setpoint_kelvin"
      }
    }
  },
  {
    "question": "reactions whose workup included an extraction",
    "why": "workups are their own repeated level, easily confused with inputs or with a WORKUP reaction_role",
    "reference": {
      "where": {
        "op": "exists",
        "path": "workups",
        "where": {
          "op": "eq",
          "path": "type",
          "value": {
            "literal": "EXTRACTION"
          }
        }
      }
    }
  },
  {
