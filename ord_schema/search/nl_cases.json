    "why": "the mass has to belong to the reactant, and the units are in the column name rather than the question",
    "reference": {
      "where": {
        "op": "exists",
        "path": "inputs.components",
        "where": {
          "op": "and",
          "clauses": [
            {
              "op": "eq",
              "path": "reaction_role",
              "value": {
                "literal": "REACTANT"
              }
            },
            {
              "op": "gt",
              "path": "amount.mass_grams",
              "value": {
                "literal": 10
              }
            }
          ]
        }
      }
    }
  },
  {
    "question": "reactions with a yield between 60 and 70%",
    "why": "both bounds have to hold of one measurement; a translation that puts them on separate measurements keeps a reaction yielding 20% and 90%",
    "reference": {
      "where": {
        "op": "exists",
        "path": "outcomes.products",
        "where": {
          "op": "exists",
          "path": "measurements",
          "where": {
            "op": "and",
            "clauses": [
              {
                "op": "eq",
                "path": "type",
                "value": {
                  "literal": "YIELD"
                }
              },
              {
                "op": "ge",
                "path": "percentage.value",
                "value": {
                  "literal": 60
                }
              },
              {
                "op": "le",
                "path": "percentage.value",
                "value": {
                  "literal": 70
                }
              }
            ]
          }
        }
      }
    }
  },
  {
    "question": "how many reactions were run on an automated platform, and how many were not?",
    "why": "a count grouped by a boolean, which asks for measured rows rather than reactions",
    "reference": {
      "aggregate": {
        "group_by": [
          "setup.is_automated"
        ],
        "measures": [
          {
            "fn": "count",
            "name": "reactions"
          }
        ]
      }
    }
  },
  {
    "question": "how many different people recorded these reactions?",
    "why": "count_distinct over a scalar, which a plain count answers wrongly and convincingly",
    "reference": {
      "aggregate": {
        "measures": [
          {
            "fn": "count_distinct",
            "path": "provenance.experimenter.username",
            "name": "people"
          }
        ]
      }
    }
  },
  {
    "question": "what is the highest yield recorded on any product?",
    "why": "a yield lives under three repeated levels, so it has to be reduced to one value per reaction before an aggregate can combine them",
    "reference": {
      "aggregate": {
        "measures": [
          {
            "fn": "max",
            "path": {
              "reduce": "max",
              "path": "outcomes.products.measurements.percentage.value"
            },
            "name": "highest"
          }
        ]
      }
    }
  },
  {
    "question": "on average, how many yield measurements does a reaction have?",
    "why": "counting a repeated level gives zero where the reaction has none, so every reaction belongs in the average; a percentage is also recorded for selectivity and purity, so the count needs the reduction's own where",
    "reference": {
      "aggregate": {
        "measures": [
          {
            "fn": "avg",
            "path": {
              "reduce": "count",
              "path": "outcomes.products.measurements.percentage.value",
              "where": {
                "op": "eq",
                "path": "type",
                "value": {
                  "literal": "YIELD"
                }
              }
            },
            "name": "yields_per_reaction"
          }
        ]
      }
    }
  },
  {
    "question": "among reactions that have at least one yield measurement, how many do they have on average?",
    "why": "the same average behind an exists, which is the only thing separating it from the question over every reaction",
    "reference": {
      "where": {
        "op": "exists",
        "path": "outcomes.products.measurements",
        "where": {
          "op": "and",
          "clauses": [
            {
              "op": "eq",
              "path": "type",
              "value": {
                "literal": "YIELD"
              }
            },
            {
              "op": "not_null",
              "path": "percentage.value"
            }
          ]
        }
      },
      "aggregate": {
        "measures": [
          {
            "fn": "avg",
            "path": {
              "reduce": "count",
              "path": "outcomes.products.measurements.percentage.value",
              "where": {
                "op": "eq",
                "path": "type",
                "value": {
                  "literal": "YIELD"
                }
              }
            },
            "name": "yields_per_reaction"
          }
        ]
      }
    }
  },
  {
    "question": "what is the average setpoint temperature, for automated and manual reactions separately?",
    "why": "an average crossing two regions, where a count of rows and an average of values look alike in the answer",
    "reference": {
      "aggregate": {
        "group_by": [
          "setup.is_automated"
        ],
        "measures": [
          {
            "fn": "avg",
            "path": "conditions.temperature.setpoint_kelvin",
            "name": "kelvin"
          }
        ]
      }
    }
  },
  {
    "question": "what are the three most common solvents?",
    "why": "grouping by something a reaction has many of, which needs the rows to be elements rather than reactions",
    "reference": {
      "aggregate": {
        "over": "inputs.components",
        "where": {
          "op": "eq",
          "path": "reaction_role",
          "value": {
            "literal": "SOLVENT"
          }
        },
        "group_by": [
          "smiles"
        ],
        "measures": [
          {
            "fn": "count_distinct",
            "path": "reaction_id",
            "name": "reactions"
          }
        ]
      },
      "order_by": [
        {
          "key": "reactions",
          "descending": true
        }
      ],
      "limit": 3
    }
  },
