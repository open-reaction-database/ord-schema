# Cursor editor (local-only rules; not part of the upstream tree).
.cursor/

# Claude Code: ephemeral agent worktrees and per-user setting overrides.
# Project-shared bits (.claude/settings.json, .claude/skills/, .claude/agents/)
# stay commitable.
.claude/worktrees/
.claude/settings.local.json

# PyCharm files.
.idea/
# Generated docs output.
docs/_build/
# Misc python.
.venv/
__pycache__
.coverage*
coverage*
*.egg-info
.ipynb_checkpoints
# vim swap files
*.sw[a-z]
# build output
/build
/dist
# Folder tracking files
.DS_Store
# Node.
package-lock.json
node_modules/

# Claude/working planning docs (local only)
*_PLAN.md
# Sphinx reads only .rst, so Markdown under docs/ is a working draft, not a page.
docs/*.md

# Files the example notebooks fetch or write while running, and read back within the
# same run: a downloaded dataset, a trained model, serialized messages. Running a
# notebook reproduces them, so committing them only offers a stale copy for review and
# leaves a dirty tree after the notebook tests.
examples/applications/Perera_Science_Granda_Nature_Suzuki/*.pb.gz
examples/applications/Perera_Science_Granda_Nature_Suzuki/saved_model.keras
examples/submissions/1_Santanilla_Nanomole_HTE/*.pbtxt
examples/submissions/1_Santanilla_Nanomole_HTE/*.pb
examples/submissions/2_Nielsen_Deoxyfluorination_Screen/ord-nielsen-example.pbtxt
examples/submissions/3_Liu_Copper_OrgSyn/example_liu.pb
examples/submissions/3_Liu_Copper_OrgSyn/example_liu.pbtxt
examples/submissions/10_Perera_Science_Suzuki/perera_dataset.pbtxt
